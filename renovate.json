{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>red-hat-data-services/konflux-central//renovate/default-renovate.json5",
    "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles",
    "security:only-security-updates"
  ],
  "enabledManagers": ["dockerfile", "gomod", "rpm", "rpm-lockfile"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Disable all updates on main — changes come from midstream",
      "matchBaseBranches": ["main"],
      "enabled": false
    },
    {
      "description": "Re-enable all Dockerfile updates on rhoai release branches; security:only-security-updates disables regular bumps and the Konflux preset allows digest updates only",
      "matchBaseBranches": ["/^rhoai-/"],
      "matchManagers": ["dockerfile"],
      "enabled": true
    }
  ]
}
