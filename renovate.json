{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "security:only-security-updates"
  ],
  "baseBranchPatterns": ["rhoai-3.5", "rhoai-3.6"],
  "enabledManagers": ["dockerfile", "gomod", "rpm-lockfile"],
  "dockerfile": {
    "includePaths": ["Dockerfile.konflux"],
    "pinDigests": true
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Allow image lookups so MintMaker can identify CVE-fixing digest updates",
      "matchManagers": ["dockerfile"],
      "enabled": true
    },
    {
      "description": "Suppress ordinary image updates after lookup; MintMaker vulnerability alerts force-enable CVE fixes",
      "matchManagers": ["dockerfile"],
      "matchJsonata": ["$exists(updateType)"],
      "enabled": false
    },
    {
      "description": "Disable RPM updates outside releases that use RPM lockfiles",
      "matchManagers": ["rpm-lockfile"],
      "matchBaseBranches": ["!rhoai-3.6"],
      "enabled": false
    }
  ],
  "rpmVulnerabilityAlerts": true,
  "rpm-lockfile": {
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["* * 31 2 *"]
    },
    "updateNotScheduled": false,
    "description": "February 31 blocks routine refreshes; MintMaker clears the schedule for RPM security candidates"
  }
}
